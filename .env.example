# Centralized AI COS Backend Environment Specifications

# Server Configuration
SERVER_PORT=8080

# AI Provider Configuration (AI_MODE=gemini|openai)
AI_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/jay-test-db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jay-test-db
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword

# Redis Cache
REDIS_URL=redis://localhost:6379

# Security & JWT Tokens
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION=900000

# Container Project Execution Mode (container|host)
PROJECT_EXECUTION_MODE=container

# External Service Integrations (Optional)
TAVILY_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GITHUB_TOKEN=
VERCEL_TOKEN=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
