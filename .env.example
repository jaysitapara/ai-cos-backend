# Backend Server Port
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JWT Security Configuration
# JWT_SECRET must be at least 32 characters (HS256 key length). No default is
# provided on purpose: the application refuses to start without one.
JWT_SECRET=your_jwt_secret_key_here
# Access token lifetime in milliseconds. Kept short because an access token
# cannot be revoked before it expires; the rotating refresh token carries the
# session and can be revoked at any time. Default 900000 (15 minutes).
JWT_EXPIRATION=900000

# Google Sign-In
# Client id from Google Cloud Console > Credentials > OAuth 2.0 Client ID
# (type "Web application"). Must match the frontend's VITE_GOOGLE_CLIENT_ID:
# an ID token issued for a different client is rejected. Leave blank to disable
# Google sign-in; /v1/auth/google then reports itself as unconfigured.
GOOGLE_CLIENT_ID=

# Authentication policy (all optional; defaults shown)
# AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
# AUTH_LOCK_DURATION_MINUTES=15
# AUTH_REFRESH_TOKEN_VALIDITY_DAYS=30
# AUTH_VERIFICATION_TOKEN_HOURS=24
# AUTH_PASSWORD_RESET_TOKEN_HOURS=2
# AUTH_LOGIN_HISTORY_RETENTION_DAYS=90
# Per-IP budget on credential endpoints, on top of the per-account lockout.
# AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Nightly sweep that purges dead refresh tokens and expired audit rows.
# AUTH_CLEANUP_CRON=0 30 3 * * *
